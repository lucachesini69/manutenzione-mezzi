# Variabili per docker-compose. Copia in ".env" (stessa cartella) e compila i valori.
#   cp .env.example .env && nano .env
# Il file .env NON va committato (è già ignorato da git).

# Password del database Postgres (scegline una forte)
DB_PASSWORD=CAMBIA_QUESTA_PASSWORD

# Chiave segreta per le sessioni. Genera con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_CON_UNA_STRINGA_CASUALE_LUNGA

# Primo utente amministratore (creato solo al primo avvio, se il DB è vuoto)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIA_QUESTA_PASSWORD

# Porta locale del server su cui esporre l'app (il reverse proxy punta qui).
# Cambiala se la 8080 è già occupata dall'altra app.
HOST_PORT=8080
