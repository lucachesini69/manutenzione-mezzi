# Copia questo file in ".env" e compila i valori reali:
#   cp .env.example .env && nano .env
# Il file .env NON va committato (contiene segreti).

# Dominio su cui sara' raggiungibile l'app (record DNS A puntato alla VPS)
DOMAIN=manutenzione.tuodominio.it

# Email per i certificati HTTPS Let's Encrypt (consigliata)
ACME_EMAIL=tua@email.it

# Password del database PostgreSQL (scegline una robusta)
DB_PASSWORD=cambia-questa-password-db

# Chiave segreta Flask. Generala con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-questa-chiave-segreta

# Credenziali di accesso all'app
APP_USERNAME=admin
APP_PASSWORD=cambia-questa-password-di-accesso
