# Variabili d'ambiente per l'applicazione.
# Copia questo file in /etc/manutenzione.env e compila i valori reali.
#   sudo cp deploy/manutenzione.env.example /etc/manutenzione.env
#   sudo nano /etc/manutenzione.env
#   sudo chmod 600 /etc/manutenzione.env
#   sudo chown manutenzione:www-data /etc/manutenzione.env

# Connessione al database Postgres locale (utente:password@host:porta/nome_db)
DATABASE_URL=postgresql://manutenzione:CAMBIA_QUESTA_PASSWORD@localhost:5432/manutenzione

# Postgres locale non usa SSL: disattiva la richiesta di SSL
PGSSLMODE=disable

# Chiave segreta per le sessioni: genera un valore casuale, es.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_CON_UNA_STRINGA_CASUALE_LUNGA

# Modalità produzione
FLASK_ENV=production

# Credenziali del primo utente amministratore (create solo al primo avvio,
# quando il database non contiene ancora nessun utente).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIA_QUESTA_PASSWORD
